+    def _dump_engine_prompt(self, prompt, request_id: str, role: str) -> None:
+        """TESTBED INSTRUMENTATION (deploy/patches/dynamo-prompt-dump.patch).
+
+        Dump the EXACT prompt this worker hands to the vLLM engine for one
+        request -- i.e. what engine_client.generate() receives AFTER the
+        Dynamo frontend applied the model's chat template and tokenized.
+        The frontend ships the worker token_ids (a TokensPrompt); this
+        reconstructs the templated prompt the model actually sees by
+        detokenizing them (DYN_PROMPT_DUMP_TEXT, default on) and/or dumps
+        the raw ids (DYN_PROMPT_DUMP_TOKENS, default off). This is the
+        prompt as the ENGINE sees it -- not OpenCode's wire `messages`
+        array (pre-template) nor a vLLM re-render.
+
+        One NDJSON record per request to
+        <DYN_PROMPT_DUMP_DIR>/prompt-<pid>.jsonl. `role` is prefill|decode
+        so PD-disaggregated workers tag their own copy (both roles receive
+        the same token_ids; filter to prefill for the canonical prompt).
+
+        Gated by DYN_PROMPT_DUMP; a full no-op otherwise (one bool check on
+        the hot path). NOTE: detokenizing + serializing a multi-thousand
+        token prompt per request adds real hot-path latency and synchronous
+        file I/O -- enable for prompt-capture runs only, NOT alongside
+        timing-sensitive profile/scheduling measurements."""
+        if not _PROMPT_DUMP_ENABLED:
+            return
+        try:
+            token_ids = None
+            prompt_text = None
+            if isinstance(prompt, dict):
+                token_ids = prompt.get("prompt_token_ids")
+                prompt_text = prompt.get("prompt")  # TextPrompt path: text already in hand
+            rec: Dict[str, Any] = {
+                "ts": time.time(),
+                "request_id": request_id,
+                "role": role,
+                "num_prompt_tokens": len(token_ids) if token_ids is not None else None,
+            }
+            if _PROMPT_DUMP_TEXT:
+                if prompt_text is not None:
+                    rec["prompt_text"] = prompt_text
+                elif token_ids is not None:
+                    tok = getattr(self.engine_client, "tokenizer", None)
+                    if tok is not None:
+                        try:
+                            rec["prompt_text"] = tok.decode(token_ids)
+                        except Exception as e:  # detokenize must never break generate
+                            rec["prompt_text"] = None
+                            rec["decode_error"] = str(e)
+                    else:
+                        rec["prompt_text"] = None
+                        rec["decode_error"] = "no tokenizer on engine_client"
+            if _PROMPT_DUMP_TOKENS and token_ids is not None:
+                rec["prompt_token_ids"] = list(token_ids)
+            _prompt_dump_file().write(json.dumps(rec) + "\n")
+        except Exception as e:  # instrumentation must never break the agent loop
+            logger.warning("prompt dump failed for %s: %s", request_id, e)
+
