{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["huggingface"],
  "provider": {
    "{{PROVIDER_ID}}": {
      "name": "{{PROVIDER_ID}}",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{{DYNAMO_BASE_URL}}",
        "apiKey": "unused"
      },
      "models": {
        "{{MODEL_SERVED_NAME}}": {
          "name": "{{MODEL_NAME}}"
        }
      }
    }
  },
  "model": "{{PROVIDER_ID}}/{{MODEL_SERVED_NAME}}",
  "agent": {
    "build":      { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} },
    "plan":       { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} },
    "general":    { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} },
    "title":      { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} },
    "summary":    { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} },
    "compaction": { "temperature": {{TEMPERATURE}}, "top_p": {{TOP_P}} }
  }
}
