+# TESTBED INSTRUMENTATION (deploy/patches/dynamo-prompt-dump.patch).
+# Opt-in capture of the EXACT prompt handed to the vLLM engine per request
+# -- the token_ids the Dynamo frontend produced AFTER applying the chat
+# template, reconstructed back to text by detokenizing them. See
+# BaseWorkerHandler._dump_engine_prompt. Read once at import; when disabled
+# every dump call costs one boolean check on the hot path.
+def _envflag(name: str, default: str = "") -> bool:
+    return os.environ.get(name, default).strip().lower() not in ("", "0", "false", "no")
+
+
+_PROMPT_DUMP_ENABLED = _envflag("DYN_PROMPT_DUMP")
+_PROMPT_DUMP_DIR = os.environ.get("DYN_PROMPT_DUMP_DIR", "/tmp/dynamo-prompt-dump")
+_PROMPT_DUMP_TEXT = _envflag("DYN_PROMPT_DUMP_TEXT", "1")  # detokenized prompt; default on
+_PROMPT_DUMP_TOKENS = _envflag("DYN_PROMPT_DUMP_TOKENS")  # raw token_ids; default off (large)
+_prompt_dump_fh = None  # lazily opened append handle, one file per worker PROCESS
+
+
+def _prompt_dump_file():
+    """One line-buffered append file per worker process: prompt-<pid>.jsonl.
+    Per-PID names keep concurrent prefill/decode workers on one host from
+    clobbering each other's dumps."""
+    global _prompt_dump_fh
+    if _prompt_dump_fh is None:
+        os.makedirs(_PROMPT_DUMP_DIR, exist_ok=True)
+        path = os.path.join(_PROMPT_DUMP_DIR, f"prompt-{os.getpid()}.jsonl")
+        _prompt_dump_fh = open(path, "a", buffering=1)
+    return _prompt_dump_fh
