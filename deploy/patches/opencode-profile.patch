 packages/opencode/src/session/processor.ts |   4 +
 packages/opencode/src/session/prompt.ts    | 234 +++++++-----
 3 files changed, 546 insertions(+), 87 deletions(-)
 create mode 100644 packages/opencode/src/profile/profile.ts

diff --git a/packages/opencode/src/profile/profile.ts b/packages/opencode/src/profile/profile.ts
new file mode 100644
index 000000000..a141b1880
--- /dev/null
+++ b/packages/opencode/src/profile/profile.ts
@@ -0,0 +1,395 @@
+// Lightweight, ENV-gated profiling for the agent loop.
+//
+// Turn it on with `OPENCODE_PROFILE=1`. When unset/0/false every Profile.*
+// method is an immediate no-op so the hot path pays only one boolean check.
+//
+// Output: one NDJSON file per session at
+//   ${OPENCODE_PROFILE_DIR}/<sessionID>.jsonl
+// with `OPENCODE_PROFILE_DIR` defaulting to `${tmpdir}/opencode-profile`.
+// The testbed (deploy/testbed.sh up_opencode) sets this to
+// `${workspace_root}/profiles` so all sessions land in one place and can
+// be aggregated with `cat`.
+//
+// Event shape (one JSON object per line):
+//   query.start  {ts, sessionID, directory}
+//   turn.start   {ts, sessionID, step, model, system, messages}
+//   llm.start    {ts, sessionID, step}
+//   llm.end      {ts, sessionID, step, finish, duration_s, step_duration_s, tokens}
+//   tool.start   {ts, sessionID, step, callID, name, kind, args_head}
+//   tool.end     {ts, sessionID, step, callID, name, ok, duration_s, [output_chars | error]}
+//   turn.end     {ts, sessionID, step, duration_s, llm_wall_s, tool_wall_s, post_overhead_s}
+//   query.end    {ts, sessionID, steps, duration_s, aborted}
+//
+// Duration semantics (see docs/opencode_step_events.md for the full lifecycle):
+//   llm.duration_s      = (first tool.start in this step | last text-end | finish-step)
+//                         - start-step. Pure LLM streaming time, NOT including tool exec.
+//   llm.step_duration_s = finish-step - start-step. Whole AI SDK step bracket.
+//   turn.duration_s     = turn.end - turn.start ≈ pre_turn + step_duration + post_turn.
+//   turn.post_overhead_s= max(0, turn.duration_s - llm_wall_s - tool_wall_s).
+//                         Lumps pre-turn setup, post-tool gap, post-step cleanup.
+//                         May be 0 when tools ran in parallel (sum > wall).
+//
+// `OPENCODE_PROFILE_MESSAGES` selects message-snapshot fidelity:
+//   count  — counts/roles only
+//   head   — per-part {role, parts, chars, head: first 200 chars}  (default)
+//   full   — entire modelMsgs JSON dumped verbatim (large; debugging only)
+
+import { appendFileSync, closeSync, existsSync, mkdirSync, openSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+
+type SnapshotLevel = "full" | "head" | "count"
+
+const envEnabled = ((): boolean => {
+  const v = process.env.OPENCODE_PROFILE
+  if (!v) return false
+  const lo = v.toLowerCase()
+  return lo !== "0" && lo !== "false" && lo !== ""
+})()
+
+const profileDir = process.env.OPENCODE_PROFILE_DIR || join(tmpdir(), "opencode-profile")
+
+const SNAPSHOT_LEVEL: SnapshotLevel = ((): SnapshotLevel => {
+  const v = process.env.OPENCODE_PROFILE_MESSAGES
+  return v === "full" || v === "count" ? v : "head"
+})()
+
+const HEAD_CHARS = 200
+
+interface SessionState {
+  startMs: number
+  fd: number
+  step: number
+  llmStartByStep: Map<number, number>
+  llmDurationByStep: Map<number, number>
+  // Earliest Profile.tool.start ms per step — best proxy for "AI SDK finished
+  // parsing tool args from the stream and is invoking execute()", which is the
+  // closest moment we can observe to "LLM streaming ended for this step".
+  firstToolStartByStep: Map<number, number>
+  // Most-recent text-end ms per step — fallback for text-only steps (final
+  // answer turns) where no tool ever runs.
+  lastTextEndByStep: Map<number, number>
+  // AI SDK `finish` event ms per step — the true client-side moment when the
+  // model's stream is fully consumed (finishReason + usage chunks received).
+  // Strictly preferred over firstTool/lastText when available.
+  streamFinishByStep: Map<number, number>
+  turnStartByStep: Map<number, number>
+  toolStart: Map<string, { ms: number; step: number; name: string }>
+  toolWallByStep: Map<number, number>
+}
+
+const sessions = new Map<string, SessionState>()
+let dirEnsured = false
+
+function ensureDir(): void {
+  if (dirEnsured) return
+  if (!existsSync(profileDir)) mkdirSync(profileDir, { recursive: true })
+  dirEnsured = true
+}
+
+function getOrInit(sessionID: string): SessionState {
+  let s = sessions.get(sessionID)
+  if (!s) {
+    ensureDir()
+    const fd = openSync(join(profileDir, `${sessionID}.jsonl`), "a")
+    s = {
+      startMs: performance.now(),
+      fd,
+      step: 0,
+      llmStartByStep: new Map(),
+      llmDurationByStep: new Map(),
+      firstToolStartByStep: new Map(),
+      lastTextEndByStep: new Map(),
+      streamFinishByStep: new Map(),
+      turnStartByStep: new Map(),
+      toolStart: new Map(),
+      toolWallByStep: new Map(),
+    }
+    sessions.set(sessionID, s)
+  }
+  return s
+}
+
+function emit(sessionID: string, row: Record<string, unknown>): void {
+  const s = sessions.get(sessionID)
+  if (!s) return
+  try {
+    appendFileSync(s.fd, JSON.stringify(row) + "\n")
+  } catch {
+    // Profiling must never break the agent loop. Swallow I/O errors silently.
+  }
+}
+
+function nowMs(): number {
+  return performance.now()
+}
+
+function unixTs(): number {
+  return Date.now() / 1000
+}
+
+function roundSec(ms: number): number {
+  return Math.round(ms) / 1000
+}
+
+// Pull dynamo's `nvext.timing` out of AI SDK's providerMetadata. AI SDK
+// keys provider-specific metadata under a per-provider name (e.g.
+// "openai-compatible", "openai") whose exact value depends on how the
+// language model was constructed in opencode -- recursively scan
+// instead of hard-coding the key so the patch survives provider
+// reshuffles. Returns null when nothing parseable is found.
+function extractDynamoTiming(pm: unknown): Record<string, number> | null {
+  if (!pm || typeof pm !== "object") return null
+  const visit = (node: any, depth: number): any => {
+    if (!node || typeof node !== "object" || depth > 4) return null
+    if (node.nvext && typeof node.nvext === "object" && node.nvext.timing) {
+      return node.nvext.timing
+    }
+    if (node.timing && typeof node.timing === "object"
+        && typeof node.timing.total_time_ms === "number") {
+      return node.timing
+    }
+    for (const v of Object.values(node)) {
+      const found = visit(v, depth + 1)
+      if (found) return found
+    }
+    return null
+  }
+  const t = visit(pm, 0)
+  if (!t) return null
+  const out: Record<string, number> = {}
+  if (typeof t.total_time_ms === "number") out.elapsed_s = t.total_time_ms / 1000
+  if (typeof t.request_received_ms === "number")
+    out.request_received_unix_s = t.request_received_ms / 1000
+  return Object.keys(out).length > 0 ? out : null
+}
+
+function contentChars(content: unknown): number {
+  if (typeof content === "string") return content.length
+  if (Array.isArray(content)) {
+    let total = 0
+    for (const p of content) {
+      if (typeof p === "string") total += p.length
+      else if (p && typeof p === "object") {
+        const t = (p as Record<string, unknown>).text
+        if (typeof t === "string") total += t.length
+        else total += JSON.stringify(p).length
+      }
+    }
+    return total
+  }
+  return 0
+}
+
+function contentHead(content: unknown): string {
+  if (typeof content === "string") return content.slice(0, HEAD_CHARS)
+  if (Array.isArray(content)) {
+    for (const p of content) {
+      if (typeof p === "string" && p) return p.slice(0, HEAD_CHARS)
+      if (p && typeof p === "object") {
+        const t = (p as Record<string, unknown>).text
+        if (typeof t === "string" && t) return t.slice(0, HEAD_CHARS)
+      }
+    }
+    return JSON.stringify(content).slice(0, HEAD_CHARS)
+  }
+  return ""
+}
+
+function summarizeMessages(messages: ReadonlyArray<{ role: string; content: unknown }>): Record<string, unknown> {
+  if (SNAPSHOT_LEVEL === "count") {
+    return {
+      messages: {
+        count: messages.length,
+        roles: messages.map((m) => m.role),
+        total_chars: messages.reduce((a, m) => a + contentChars(m.content), 0),
+      },
+    }
+  }
+  if (SNAPSHOT_LEVEL === "full") {
+    return { messages }
+  }
+  return {
+    messages: messages.map((m) => ({
+      role: m.role,
+      parts: Array.isArray(m.content) ? m.content.length : 1,
+      chars: contentChars(m.content),
+      head: contentHead(m.content),
+    })),
+  }
+}
+
+function summarizeSystem(system: ReadonlyArray<string>): Record<string, unknown> {
+  const chars = system.reduce((a, s) => a + s.length, 0)
+  if (SNAPSHOT_LEVEL === "count") return { system: { count: system.length, chars } }
+  if (SNAPSHOT_LEVEL === "full") return { system: { count: system.length, chars, texts: system } }
+  return { system: { count: system.length, chars, head: system[0]?.slice(0, HEAD_CHARS) ?? "" } }
+}
+
+function previewJSON(v: unknown): string {
+  try {
+    return JSON.stringify(v).slice(0, HEAD_CHARS)
+  } catch {
+    return ""
+  }
+}
+
+export const Profile = {
+  enabled: envEnabled,
+  dir: profileDir,
+
+  query: {
+    start(sessionID: string, meta: { directory?: string } = {}): void {
+      if (!envEnabled) return
+      const s = getOrInit(sessionID)
+      s.startMs = nowMs()
+      emit(sessionID, {
+        ev: "query.start",
+        ts: unixTs(),
+        sessionID,
+        directory: meta.directory,
+      })
+    },
+    end(sessionID: string, meta: { steps: number; aborted?: boolean }): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      emit(sessionID, {
+        ev: "query.end",
+        ts: unixTs(),
+        sessionID,
+        steps: meta.steps,
+        duration_s: roundSec(nowMs() - s.startMs),
+        aborted: !!meta.aborted,
+      })
+      try {
+        closeSync(s.fd)
+      } catch {
+        /* ignore */
+      }
+      sessions.delete(sessionID)
+    },
+  },
+
+  turn: {
+    start(
+      sessionID: string,
+      step: number,
+      snap: {
+        system: ReadonlyArray<string>
+        messages: ReadonlyArray<{ role: string; content: unknown }>
+        model?: { id: string; providerID: string }
+      },
+    ): void {
+      if (!envEnabled) return
+      const s = getOrInit(sessionID)
+      s.step = step
+      s.turnStartByStep.set(step, nowMs())
+      s.toolWallByStep.set(step, 0)
+      emit(sessionID, {
+        ev: "turn.start",
+        ts: unixTs(),
+        sessionID,
+        step,
+        model: snap.model,
+        ...summarizeSystem(snap.system),
+        ...summarizeMessages(snap.messages),
+      })
+    },
+    end(sessionID: string, step: number): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      const start = s.turnStartByStep.get(step)
+      if (start == null) return
+      const turnMs = nowMs() - start
+      const llmMs = s.llmDurationByStep.get(step) ?? 0
+      const toolMs = s.toolWallByStep.get(step) ?? 0
+      // turn.duration ≈ pre_turn_overhead + llm_wall + tool_wall + post_tool_gap + post_turn_overhead.
+      // Lump the three non-LLM/non-tool slices into post_overhead_s.
+      // Clamped at 0 because parallel tool steps have Σtool > wall(tool).
+      const postMs = Math.max(0, turnMs - llmMs - toolMs)
+      emit(sessionID, {
+        ev: "turn.end",
+        ts: unixTs(),
+        sessionID,
+        step,
+        duration_s: roundSec(turnMs),
+        llm_wall_s: roundSec(llmMs),
+        tool_wall_s: roundSec(toolMs),
+        post_overhead_s: roundSec(postMs),
+      })
+      s.turnStartByStep.delete(step)
+    },
+  },
+
+  llm: {
+    start(sessionID: string): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      s.llmStartByStep.set(s.step, nowMs())
+      emit(sessionID, { ev: "llm.start", ts: unixTs(), sessionID, step: s.step })
+    },
+    // Fired from processor.ts case "text-end" — marks "model finished
+    // streaming a text block". For text-only steps (final answer turns)
+    // this is the cleanest end-of-LLM marker. For text+tool steps it is
+    // overridden later by firstToolStartByStep (see llm.end).
+    streamingEnd(sessionID: string): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      s.lastTextEndByStep.set(s.step, nowMs())
+    },
+    // Fired from processor.ts case "finish" — the AI SDK's "stream
+    // fully consumed" event, which carries `providerMetadata`. For
+    // Dynamo-fronted requests this includes the `nvext.timing` block
+    // (request_received_ms, total_time_ms) embedded by the dynamo
+    // frontend right next to finish_reason — i.e. dynamo's elapsed_ms
+    // arrives in-band rather than via log scraping.
+    streamFinish(
+      sessionID: string,
+      info: { finish?: string; tokens?: unknown; providerMetadata?: unknown },
+    ): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      const now = nowMs()
+      s.streamFinishByStep.set(s.step, now)
+      emit(sessionID, {
+        ev: "llm.stream-finish",
+        ts: unixTs(),
+        sessionID,
+        step: s.step,
+        finish: info.finish,
+        tokens: info.tokens,
+        provider_metadata: info.providerMetadata,
+        dynamo: extractDynamoTiming(info.providerMetadata),
+      })
+    },
+    end(
+      sessionID: string,
+      info: { finish?: string; tokens: unknown; providerMetadata?: unknown },
+    ): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      const start = s.llmStartByStep.get(s.step)
+      const stepEnd = nowMs()
+      // Priority: AI SDK `finish` event (most accurate — set by
+      // streamFinish hook above; reflects the true client-side moment
+      // when the stream was fully consumed) > first tool.start > last
+      // text-end > finish-step itself.
+      const streamFinish = s.streamFinishByStep.get(s.step)
+      const firstTool = s.firstToolStartByStep.get(s.step)
+      const lastText = s.lastTextEndByStep.get(s.step)
+      const streamEnd = streamFinish ?? firstTool ?? lastText ?? stepEnd
+      const llmMs = start != null ? streamEnd - start : 0
+      const stepMs = start != null ? stepEnd - start : 0
+      // post_stream_overhead_s = framework finalization between stream
+      // end and finish-step (snapshot.track + snapshot.patch + DB
+      // writes + EventV2 dual-write; see processor.ts:455-514).
+      const postStreamMs = streamFinish != null && start != null
+        ? Math.max(0, stepEnd - streamFinish)
+        : null
+      s.llmDurationByStep.set(s.step, llmMs)
+      s.llmStartByStep.delete(s.step)
+      s.firstToolStartByStep.delete(s.step)
+      s.lastTextEndByStep.delete(s.step)
+      s.streamFinishByStep.delete(s.step)
+      emit(sessionID, {
+        ev: "llm.end",
+        ts: unixTs(),
+        sessionID,
+        step: s.step,
+        finish: info.finish,
+        duration_s: roundSec(llmMs),
+        step_duration_s: roundSec(stepMs),
+        post_stream_overhead_s: postStreamMs != null ? roundSec(postStreamMs) : null,
+        tokens: info.tokens,
+        dynamo: extractDynamoTiming(info.providerMetadata),
+      })
+    },
+  },
+
+  tool: {
+    start(
+      sessionID: string,
+      callID: string,
+      name: string,
+      kind: "builtin" | "mcp",
+      args: unknown,
+    ): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      const ms = nowMs()
+      s.toolStart.set(callID, { ms, step: s.step, name })
+      // First tool.start of THIS step marks the end of LLM streaming:
+      // AI SDK has fully parsed the model's tool_call from the stream and
+      // is invoking execute(). Subsequent (parallel) tool starts in the
+      // same step don't change this — keep the earliest.
+      if (!s.firstToolStartByStep.has(s.step)) {
+        s.firstToolStartByStep.set(s.step, ms)
+      }
+      emit(sessionID, {
+        ev: "tool.start",
+        ts: unixTs(),
+        sessionID,
+        step: s.step,
+        callID,
+        name,
+        kind,
+        args_head: previewJSON(args),
+      })
+    },
+    end(
+      sessionID: string,
+      callID: string,
+      info: { ok: boolean; output_chars?: number; error?: string },
+    ): void {
+      if (!envEnabled) return
+      const s = sessions.get(sessionID)
+      if (!s) return
+      const start = s.toolStart.get(callID)
+      if (!start) return
+      const duration = nowMs() - start.ms
+      s.toolStart.delete(callID)
+      s.toolWallByStep.set(start.step, (s.toolWallByStep.get(start.step) ?? 0) + duration)
+      emit(sessionID, {
+        ev: "tool.end",
+        ts: unixTs(),
+        sessionID,
+        step: start.step,
+        callID,
+        name: start.name,
+        ok: info.ok,
+        ...(info.ok ? { output_chars: info.output_chars ?? 0 } : { error: info.error ?? "" }),
+        duration_s: roundSec(duration),
+      })
+    },
+  },
+}
