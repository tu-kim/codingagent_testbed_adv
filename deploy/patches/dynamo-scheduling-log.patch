+    @staticmethod
+    def _log_scheduling_delay(
+        request_output: RequestOutput, request_id: str, role: str
+    ) -> None:
+        """TESTBED INSTRUMENTATION (deploy/patches/dynamo-scheduling-log.patch).
+
+        Emit one structured log line per request carrying the engine
+        scheduler queue-wait (= scheduling delay): the gap between when
+        the request entered the scheduler WAITING queue and when it was
+        first scheduled for compute. Read from vLLM v1's per-request
+        RequestOutput.metrics (RequestStateStats.queued_ts ->
+        scheduled_ts; requires log_stats=True, which dynamo enables by
+        default). `role` is prefill|decode -- with PD disaggregation the
+        prefill and decode workers each call this with their own
+        RequestOutput, so the two lines for one request_id give prefill
+        vs decode scheduling delay separately.
+
+        Parsed by scripts/analyze_worker_scheduling.py from the per-worker
+        logs/vllm-*.log. No-op when metrics / the timestamps are absent
+        (log_stats off, or a cache-only / preempted request with 0 ts) --
+        the value can't reach the client in-band (the frontend drops
+        unknown OpenAI usage keys and nvext is Rust-only), so the worker
+        log is the per-request sink."""
+        m = getattr(request_output, "metrics", None)
+        if m is None:
+            return
+        queued = getattr(m, "queued_ts", None)
+        scheduled = getattr(m, "scheduled_ts", None)
+        if not queued or not scheduled:
+            return
+        queue_ms = (scheduled - queued) * 1000.0
+        logger.info(
+            "SCHED_DELAY request_id=%s role=%s queue_ms=%.3f "
+            "queued_ts=%.6f scheduled_ts=%.6f",
+            request_id,
+            role,
+            queue_ms,
+            queued,
+            scheduled,
+        )
+
