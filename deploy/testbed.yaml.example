# Single source of truth for the testbed.
# Schema is mirrored by src/testbed/config.py — keep them in sync.
# Override any value via TESTBED__SECTION__KEY env vars (parsed as YAML scalars).

# Shared by OpenCode (parent of session subdirs) and runner (clone target).
workspace_root: /tmp/testbed-workspaces

model:
  name: qwen3-coder-30b-a3b      # HF id or local path; default
  served_name: local             # OpenCode provider model id used in opencode.json
  # Sampling overrides for ALL primary agents (build / plan / general /
  # title / summary / compaction). temperature=0 + top_p=1.0 = greedy.
  # `seed` is added to the OpenAI-compat request body via opencode's
  # providerOptions, ending up in vLLM's SamplingParams.seed
  # (dynamo/components/src/dynamo/vllm/handlers.py:411 maps it). With
  # temp=0, greedy ignores seed for token selection, but it still
  # pins any tie-breaking RNG draws in the sampler. See `vllm.seed`
  # below for the ENGINE-level seed (scheduler tie-breaking etc).
  temperature: 0.0
  top_p: 1.0
  seed: 42

vllm:
  kv_connector: NixlConnector    # vLLM KV-transfer connector class name
  nixl_port_base: 6000           # rank N → VLLM_NIXL_SIDE_CHANNEL_PORT = base + N*100
  # Each worker exposes Prometheus /metrics + /health when DYN_SYSTEM_PORT
  # is positive. We give each worker rank a unique port = base + rank,
  # so curl http://<worker.host>:21000/metrics works for rank 0, 21001 for rank 1, ...
  # Set to -1 to keep the system server disabled.
  system_port_base: 21000
  # vLLM optimization toggles forwarded as --enable-X / --no-enable-X to
  # `dynamo.vllm`. Tri-state: null/omitted → don't pass the flag (vLLM
  # default kicks in, currently enable_prefix_caching=True on v1);
  # true → --enable-X; false → --no-enable-X.
  #
  # Defaults stay null so vLLM throughput optimizations remain on.
  # In practice, prefix caching / chunked prefill / continuous batching
  # introduce only epsilon-level floating-point variance which almost
  # never flips greedy argmax for typical SWE-bench text. If you
  # observe output divergence with seed pinned, flip these to false
  # one at a time and bisect.
  enable_prefix_caching: null
  enable_chunked_prefill: null
  # Engine-level vLLM seed (--seed N). Pinning this ensures the
  # scheduler / sampler RNG starts identically across runs so any
  # tie-break draws (rare with temp=0 greedy but they exist) land the
  # same. Cheap determinism with zero throughput cost.
  seed: 42
  # The two flags below default to null = keep vLLM defaults. Flip to
  # true ONLY if seed alone doesn't give stable argmax:
  #   enforce_eager: true disables CUDA graph capture (~5-15% slower).
  #   disable_custom_all_reduce: true on TP>1 forces NCCL reductions.
  enforce_eager: null
  disable_custom_all_reduce: null

  # Server-side default sampling params, passed to vLLM as
  # --override-generation-config '<json>'. Merges INTO the model's
  # generation_config.json before per-request SamplingParams are built.
  # Why this exists: Qwen ships generation_config.json with
  # `temperature: 0.7, top_p: 0.8, top_k: 20, repetition_penalty: 1.05`,
  # and `repetition_penalty` is applied to logits BEFORE argmax -- so
  # leaving it at 1.05 tilts even greedy decoding away from a pure
  # argmax. Pinning to neutral closes the last reproducibility gap
  # that --seed alone doesn't cover. Per-request overrides (opencode's
  # `model.temperature` / `model.top_p` + the seed wired via
  # providerOptions) still win on a field-by-field basis; this just
  # changes the SERVER DEFAULT for any field the client doesn't set.
  # Set to null (or to an empty mapping {}) to skip the flag and let
  # Qwen's generation_config.json defaults flow through unmodified.
  # Override the WHOLE dict via TESTBED__VLLM__OVERRIDE_GENERATION_CONFIG
  # passing a JSON string (env-var replacement is whole-value, not per-key).
  override_generation_config:
    temperature: 0.0
    top_p: 1.0
    top_k: -1
    repetition_penalty: 1.0

  # Dynamo's Rust-side tool-call parser. Applied ONLY to decode workers via
  # `--dyn-tool-call-parser <name>` (dynamo/components/src/dynamo/vllm/main.py:723-724
  # skips Prefill). Without it the frontend logs
  # "tool choice 'auto' specified but no tool parser configured" and the agent
  # loop receives raw text instead of structured tool_calls. Set to empty
  # string to disable. Valid names per dynamo/lib/parsers/src/tool_calling/parsers.rs
  # (underscore-form; hyphenated aliases like minimax-m3 also accepted at runtime):
  #   deepseek_v3 deepseek_v3_1 deepseek_v3_2 deepseek_v4 deepseekv4 default
  #   gemma4 glm47 harmony hermes jamba kimi_k2 llama3_json minimax_m2 minimax_m3
  #   minimax_m3_nom mistral nemotron_deci nemotron_nano phi4 pythonic qwen25 qwen3_coder
  tool_call_parser: qwen3_coder  # default fits qwen3-coder-30b-a3b; minimax_m3 for MiniMax M3

  # Each worker entry:
  #   host: where this worker is deployed. Default 127.0.0.1.
  #         Doubles as VLLM_NIXL_SIDE_CHANNEL_HOST for that worker.
  #         Single-node only at present; multi-node SSH spawn is TBD.
  #   gpus: comma-separated GPU ids. Must satisfy len(split(',')) == tp * pp.
  prefill_workers:
    - { name: p0, host: 127.0.0.1, gpus: "0,1", tp: 2, pp: 1 }
  decode_workers:
    - { name: d0, host: 127.0.0.1, gpus: "2,3", tp: 2, pp: 1 }

  prefill:
    max_model_len: 32768
    max_num_batched_tokens: 8192
    max_num_seqs: 16
    gpu_memory_utilization: 0.90
    kv_cache_dtype: auto         # auto | fp8 | fp8_e4m3 | fp8_e5m2

  decode:
    max_model_len: 32768
    max_num_batched_tokens: 2048
    max_num_seqs: 64
    gpu_memory_utilization: 0.90
    kv_cache_dtype: auto

  extra_args: ""                 # appended to every vLLM serve invocation

dynamo:
  host: 127.0.0.1                # → --http-host on dynamo.frontend
  port: 8000                     # → --http-port on dynamo.frontend
  router_mode: round-robin       # round-robin | least-loaded | kv | random | power-of-two | direct | device-aware-weighted
  discovery_backend: etcd        # → --discovery-backend (kubernetes | etcd | file | mem)
  etcd_endpoints: http://127.0.0.1:2379   # → ETCD_ENDPOINTS env on every dynamo process
  nats_url: nats://127.0.0.1:4222         # → NATS_SERVER env on every dynamo process
  request_plane: tcp             # → --request-plane (tcp | nats | http)
  event_plane: nats              # → --event-plane (nats | zmq)

opencode:
  host: 127.0.0.1                # → --hostname on `opencode serve`
  port: 4096                     # → --port on `opencode serve`
  experimental_workspaces: true  # → OPENCODE_EXPERIMENTAL_WORKSPACES=true env

# Optional resource monitor (DCGM GPU + psutil CPU/per-process).
# Brought up explicitly with `testbed.sh up monitor` (requires sudo).
# NOT included in `up all` / `down all` — bring up and tear down
# separately. Sudo strips env vars, so dcgm_py/dcgm_bindings_path live
# here (yaml) rather than as $DCGM_PY / $DCGM_BINDINGS_PATH exports.
monitor:
  # REQUIRED for `up monitor`. Path to the Python interpreter that has
  # DCGM bindings installed (or can find them via dcgm_bindings_path).
  # Examples: /usr/bin/python3 (if you `pip install pydcgm` system-wide),
  # /home/$USER/.venv/bin/python (a venv with pydcgm installed).
  dcgm_py: ""
  # OPTIONAL. Directory containing dcgm_fields.py / dcgm_structs.py.
  # Set when DCGM is installed system-side but bindings aren't pip-
  # discoverable from dcgm_py. Common locations:
  #   /usr/local/dcgm/bindings/python3
  #   /usr/local/dcgm-4/bindings/python3
  # Leave empty if the bindings are already on dcgm_py's sys.path.
  dcgm_bindings_path: ""
  interval_s: 1.0                # drain period: how often we write an NDJSON row
  # DCGM's internal sampling period. DCGM samples every dcgm_update_freq_s
  # and buffers; we drain every interval_s -- so each row aggregates
  # interval_s / dcgm_update_freq_s samples per field per GPU into
  # {mean,min,max,n}. Counter fields (PCIe/NVLink bytes) keep the last
  # value so downstream delta-bandwidth math is unaffected. Capped at 1s
  # by DCGM perfworks (longer windows round short compute bursts to 0).
  dcgm_update_freq_s: 0.1
  output: logs/resource.ndjson   # relative to repo root
  # Per-process PID tracking source. Pointed at logs/ so every
  # component spawned by testbed.sh (vllm-*, dynamo-*, opencode) is
  # auto-discovered from its <name>.pid file.
  pids_from: logs/
  # vLLM /metrics scraper (separate component spawned by `up scrape_metrics`).
  # Polls each worker's DYN_SYSTEM_PORT-exposed /metrics endpoint and
  # writes NDJSON. Requires vllm.system_port_base > 0.
  scrape_interval_s: 1.0
  scrape_output: logs/vllm_metrics.ndjson
  # Exact-name allowlist of vLLM Prometheus metric names. null = use
  # scrape_vllm_metrics.py's DEFAULT_METRIC_NAMES (~13 names: KV-cache +
  # queue depth + token throughput + the request_queue_time_seconds
  # histogram = prefill/decode scheduling delay). OTHER latency
  # histograms (TTFT etc.) are skipped because nvext.timing + opencode
  # profile already record per-request latency; queue-wait is the one
  # exception since it isn't recoverable client-side.
  # Specify a list to override. Use `--keep-all` for raw debugging.
  vllm_metric_names: null
  # Example -- add TTFT histogram back on top of the default set
  # (names match vLLM v0.19.0; v1 engine dropped the `gpu_` prefix):
  #   vllm_metric_names:
  #     - vllm:kv_cache_usage_perc
  #     - vllm:num_preemptions_total
  #     - vllm:prefix_cache_queries_total
  #     - vllm:prefix_cache_hits_total
  #     - vllm:prompt_tokens_cached_total
  #     - vllm:num_requests_running
  #     - vllm:num_requests_waiting
  #     - vllm:prompt_tokens_total
  #     - vllm:generation_tokens_total
  #     - vllm:time_to_first_token_seconds_bucket
  #     - vllm:time_to_first_token_seconds_count
  #     - vllm:time_to_first_token_seconds_sum
